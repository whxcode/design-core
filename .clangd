CompileFlags:
  # 1. 踢掉 em++ 传给真实编译器的 wasm/linker 参数，clangd 只做语义解析
  Remove: [-s*, -m*, -f*, --sysroot*]

  Add: [
      "-std=c++23",
      "-xc++",
      "-D__EMSCRIPTEN__",
      "-target",
      "wasm32-unknown-emscripten",
      # 2. 精准补丁：把当前 WSL emsdk 的 sysroot 喂给 clangd
      # 这个路径是给 LSP 用的，不影响实际编译（build.sh 不看这里）
      "-isystem",
      "/home/whx/webProject/emsdk/upstream/emscripten/cache/sysroot/include/c++/v1",
      "-isystem",
      "/home/whx/webProject/emsdk/upstream/emscripten/cache/sysroot/include/fakesdl",
      "-isystem",
      "/home/whx/webProject/emsdk/upstream/emscripten/cache/sysroot/include/compat",
      "-isystem",
      "/home/whx/webProject/design/design-core/build_wasm/.emscripten_cache/sysroot/include",
      "-isystem",
      "/home/whx/webProject/emsdk/upstream/emscripten/cache/sysroot/include",
      # 3a. Node.js headers（用于 addon/napi 开发，z-nodeapi/ 下的文件）
      "-isystem",
      "/home/whx/.nvm/versions/node/v22.22.2/include/node",
      # 4. 屏蔽假报错
      "-Wno-nullability-completeness",
      "-Wno-unknown-argument",
    ]

Diagnostics:
  Suppress:
    ["drv_unknown_argument", "nullability-completeness", "unused-includes"]
